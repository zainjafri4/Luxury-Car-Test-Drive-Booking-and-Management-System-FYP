# ---------- Dependencies ----------
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ---------- Environment & secrets (NEVER commit) ----------
.env
.env.*
!.env.example
*.pem
*.key
*.crt
*.p12
secrets/
credentials.json

# ---------- Build output ----------
dist/
build/
out/
.next/
.turbo/
.vercel/
*.tsbuildinfo
next-env.d.ts

# ---------- Test, coverage, reports ----------
coverage/
.nyc_output/
test-results/
playwright-report/
playwright/.cache/
blob-report/
.vitest/

# ---------- Logs ----------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ---------- Caches ----------
.cache/
.eslintcache
.prettiercache
.parcel-cache/
.npm/
.tmp/
tmp/

# ---------- Uploads (keep the folder, ignore contents) ----------
apps/api/uploads/*
!apps/api/uploads/.gitkeep

# ---------- Database / Docker local data ----------
pgdata/
postgres-data/
.docker/
*.sqlite
*.sqlite3
*.db
*.dump
*.sql.gz
# Prisma: migrations ARE committed; only local artefacts are ignored
apps/api/prisma/*.db
apps/api/prisma/*.db-journal

# ---------- OS files ----------
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# ---------- Editors / IDEs (share only useful VS Code files) ----------
.idea/
*.swp
*.swo
*~
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json
!.vscode/tasks.json

# ---------- Local AI-agent / tooling artefacts ----------
# Graphify cache (the generated graph report may be committed; caches may not)
graphify-out/cache/
.graphify/cache/
.claude/settings.local.json
*.local.md

# ---------- Misc ----------
*.pid
*.seed
*.pid.lock
.vercel
.env.local

